{
  "name": "@projectapp/shared-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned interface contracts shared by apps/web, apps/api and apps/scheduler",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
