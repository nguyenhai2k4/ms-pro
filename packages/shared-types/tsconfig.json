{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true,
    // DOM is needed only by src/gantt.ts (the client-side rendering contract). It is exposed
    // through the "./gantt" subpath so Node services never inherit it — see src/index.ts.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"]
}
