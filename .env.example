# ProjectApp — environment template.
# Copy to `.env` and fill in. Real values NEVER enter the repo (CLAUDE.md: secrets are env vars only).
# Every variable the services read must be documented here, with a placeholder value.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Postgres (packages/db) — PostgreSQL 15+ per docs/IMPLEMENTATION-PLAN.md §3
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=projectapp
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=projectapp
DATABASE_URL=postgres://projectapp:change-me-locally@localhost:5432/projectapp

# ---------------------------------------------------------------------------
# Redis — WebSocket pub/sub fan-out + BullMQ export queue (ADR-002, §3)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Object storage (S3-compatible; MinIO locally) — exported PDF/XLSX/JSON (FR-RPT-04..06)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=projectapp-exports
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
# FR-AUTH-03: signing key for session bearer credentials. Min 32 chars. Rotate per environment.
AUTH_SESSION_SECRET=dev-only-insecure-secret-change-me-32chars
AUTH_SESSION_TTL_SECONDS=86400
# FR-AUTH-01: argon2id/bcrypt cost factor. Keep high enough that a leak is not trivially reversible.
AUTH_PASSWORD_HASH_COST=12

# FR-AUTH-02: managed auth provider for Google/Microsoft OAuth.
# Not wired in P0 — see docs/IMPLEMENTATION-PLAN.md §3 (Auth0/Clerk for MVP).
OAUTH_PROVIDER_ISSUER_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Scheduler service (apps/scheduler) — stateful per active project
# ---------------------------------------------------------------------------
SCHEDULER_HOST=0.0.0.0
SCHEDULER_PORT=3002
# Project -> instance affinity key namespace. Intents for a project must reach the instance
# that owns it, or ADR-002's per-project ordering guarantee breaks under concurrency.
SCHEDULER_AFFINITY_NAMESPACE=projectapp:sched:owner

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_BASE_URL=ws://localhost:3002

# ---------------------------------------------------------------------------
# Observability — OpenTelemetry from P0; FRS perf targets are unverifiable without it
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=projectapp

# ---------------------------------------------------------------------------
# Gantt vendor (ADR-001 / ADR-006)
# Credentials for the vendor-private registry. Unset in P0: no license procured yet, so the
# placeholder adapter is in use. Vendor integration is gated before P1 exit.
# ---------------------------------------------------------------------------
GANTT_VENDOR_REGISTRY_URL=
GANTT_VENDOR_REGISTRY_TOKEN=
